<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131A"
    tools:context=".cardgame.CardActivity">

    <!-- OUTER CARD TEMPLATE WITH GOLD BORDER -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTemplate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#000000"
        app:strokeColor="#FFD700"
        app:strokeWidth="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/headerBar"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:background="#000000"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- CARD CODE BADGE -->
                <FrameLayout
                    android:id="@+id/codeBadge"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:background="#FFD700">

                    <TextView
                        android:id="@+id/cardCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textColor="#000000"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/pixeboy"/>
                </FrameLayout>

                <!-- CARD NAME -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/cardName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFD700"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/pixeboy"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>

            <!-- IMAGE FRAME WITH BUTTONS INSIDE -->
            <FrameLayout
                android:id="@+id/imageFrame"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="#1C2127"
                app:layout_constraintTop_toBottomOf="@id/headerBar"
                app:layout_constraintBottom_toTopOf="@id/cardTypeLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- CARD IMAGE -->
                <ImageView
                    android:id="@+id/cardImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@null"/>

                <!-- SUPER ULTIMA LABEL -->
                <TextView
                    android:id="@+id/superUltimaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="55dp"
                    android:background="#99000000"
                    android:gravity="center"
                    android:text="★ SUPER ULTIMA ★"
                    android:textColor="#FF0000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pixeboy"
                    android:visibility="gone"/>

                <!-- PREV BUTTON (Inside Image Frame) -->
                <Button
                    android:id="@+id/prevButton"
                    android:layout_width="75dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="PREV"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#333333"
                    android:fontFamily="@font/pixeboy"/>

                <!-- HOME BUTTON (Inside Image Frame) -->
                <Button
                    android:id="@+id/homeButton"
                    android:layout_width="75dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|center"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#333333"
                    android:fontFamily="@font/pixeboy"
                    android:text="HOME"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <!-- NEXT BUTTON (Inside Image Frame) -->
                <Button
                    android:id="@+id/nextButton"
                    android:layout_width="75dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="NEXT"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#333333"
                    android:fontFamily="@font/pixeboy"/>
            </FrameLayout>

            <!-- CARD TYPE SUB-HEADER (FIGHTER) + READ MORE BUTTON -->
            <LinearLayout
                android:id="@+id/cardTypeLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="4dp"
                android:paddingStart="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/imageFrame"
                app:layout_constraintBottom_toTopOf="@id/statsContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/cardType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pixeboy"/>

                <Button
                    android:id="@+id/readMoreButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="READ MORE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:backgroundTint="#333333"
                    android:fontFamily="@font/pixeboy"/>
            </LinearLayout>

            <!-- STATISTICS CONTAINER (3 Rows of 2 Cards) -->
            <LinearLayout
                android:id="@+id/statsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- ROW 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <!-- STAT 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statCard1"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#1C2127"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/label1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFD700"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/homevideoboldr90dv"/>

                            <TextView
                                android:id="@+id/value1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="@font/pixeboy"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- STAT 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statCard2"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#1C2127"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/label2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFD700"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/homevideoboldr90dv"/>

                            <TextView
                                android:id="@+id/value2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="@font/pixeboy"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ROW 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <!-- STAT 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statCard3"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#1C2127"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/label3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFD700"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/homevideoboldr90dv"/>

                            <TextView
                                android:id="@+id/value3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="@font/pixeboy"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- STAT 4 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statCard4"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#1C2127"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/label4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFD700"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/homevideoboldr90dv"/>

                            <TextView
                                android:id="@+id/value4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="@font/pixeboy"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ROW 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- STAT 5 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statCard5"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#1C2127"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/label5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFD700"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/homevideoboldr90dv"/>

                            <TextView
                                android:id="@+id/value5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="@font/pixeboy"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- STAT 6 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/statCard6"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardBackgroundColor="#1C2127"
                        app:strokeColor="#333333"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/label6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFD700"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/homevideoboldr90dv"/>

                            <TextView
                                android:id="@+id/value6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="@font/pixeboy"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ROUND RESULT OVERLAY: replaces the plain AlertDialog with a themed,
         animated reveal that matches the rest of the app's look. Hidden
         until a round is played. -->
    <FrameLayout
        android:id="@+id/roundResultOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E6000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCardContainer"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="#000000"
            app:strokeColor="#FFD700"
            app:strokeWidth="4dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <!-- Suspense beat shown BEFORE the result reveals -->
                <TextView
                    android:id="@+id/vsPulseText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VS"
                    android:textColor="#FFD700"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pixeboy"/>

                <!-- Everything below fades/flips in on reveal, as one group -->
                <LinearLayout
                    android:id="@+id/resultRevealGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/resultBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFD700"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/pixeboy"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/resultStatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#AAAAAA"
                        android:textSize="16sp"
                        android:fontFamily="@font/homevideoboldr90dv"
                        android:layout_marginBottom="12dp"/>

                    <!-- One row per active player is added here at runtime -
                         supports 2, 3, or 4 players, not just a fixed pair. -->
                    <LinearLayout
                        android:id="@+id/resultValuesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/continuePrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="TAP TO CONTINUE"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:fontFamily="@font/homevideoboldr90dv"/>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
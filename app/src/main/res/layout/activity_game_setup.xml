<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131A"
    android:padding="24dp"
    tools:context=".GameSetupActivity">

    <!-- TITLE -->
    <TextView
        android:id="@+id/setupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/pixeboy"
        android:text="GAME SETUP"
        android:textColor="#FFD700"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/setupSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/homevideoboldr90dv"
        android:text="CHOOSE YOUR SUPER ULTIMA DUEL MODE"
        android:textColor="#737B84"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/setupTitle" />

    <!-- HOST / JOIN ROLE SELECTOR (NEW) -->
    <LinearLayout
        android:id="@+id/roleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/setupSubtitle">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoleHost"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFD700"
            android:fontFamily="@font/pixeboy"
            android:text="HOST GAME"
            android:textColor="#000000"
            android:textSize="14sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoleJoin"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#1E232A"
            android:fontFamily="@font/pixeboy"
            android:text="JOIN GAME"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:strokeColor="#3A424D"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- DUEL MODE SECTION -->
    <TextView
        android:id="@+id/duelModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/homevideoboldr90dv"
        android:text="DUEL MODE"
        android:textColor="#FFD700"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/roleContainer" />

    <!-- 2-WAY MODE SELECTOR CONTAINER (BOT vs PASS & PLAY) -->
    <LinearLayout
        android:id="@+id/duelModeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/duelModeLabel">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeBot"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFD700"
            android:fontFamily="@font/pixeboy"
            android:text="VS BOT / CPU"
            android:textColor="#000000"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:strokeColor="#FFD700"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModePassPlay"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#1E232A"
            android:fontFamily="@font/pixeboy"
            android:text="PASS &amp; PLAY"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="10dp"
            app:strokeColor="#3A424D"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- CHOOSE DECK THEME SECTION -->
    <TextView
        android:id="@+id/deckThemeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/homevideoboldr90dv"
        android:text="CHOOSE DECK THEME"
        android:textColor="#FFD700"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/duelModeContainer" />

    <Spinner
        android:id="@+id/deckSpinner"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="#1E232A"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/deckThemeLabel" />

    <!-- NUMBER OF PLAYERS SECTION -->
    <TextView
        android:id="@+id/playersLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/homevideoboldr90dv"
        android:text="NUMBER OF PLAYERS (2 - 4)"
        android:textColor="#FFD700"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/deckSpinner" />

    <LinearLayout
        android:id="@+id/playersCountContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playersLabel">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2Players"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFD700"
            android:fontFamily="@font/pixeboy"
            android:text="2 PLAYERS"
            android:textColor="#000000"
            android:textSize="14sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3Players"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:backgroundTint="#1E232A"
            android:fontFamily="@font/pixeboy"
            android:text="3 PLAYERS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4Players"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#1E232A"
            android:fontFamily="@font/pixeboy"
            android:text="4 PLAYERS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- STATUS & DECK INFO BOX -->
    <TextView
        android:id="@+id/deckInfoText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#171C24"
        android:fontFamily="@font/homevideoboldr90dv"
        android:gravity="center"
        android:padding="14dp"
        android:text="MODE: VS BOT / CPU SELECTED."
        android:textColor="#A0AAB5"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playersCountContainer" />

    <!-- BOTTOM ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#1E232A"
            android:fontFamily="@font/pixeboy"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartDuel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.5"
            android:backgroundTint="#FFD700"
            android:fontFamily="@font/pixeboy"
            android:text="START DUEL"
            android:textColor="#000000"
            android:textSize="16sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
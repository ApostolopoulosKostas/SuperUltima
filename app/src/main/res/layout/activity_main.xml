<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131A"
    tools:context=".MainActivity">

    <!-- TITLE -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/pixeboy"
        android:text="SUPER ULTIMA"
        android:textColor="#FFD700"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- HORIZONTAL SCROLLVIEW FOR ALL DECKS -->
    <HorizontalScrollView
        android:id="@+id/decksHorizontalScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText">

        <!-- DECKS ARE ADDED HERE BY JAVA -->
        <LinearLayout
            android:id="@+id/decksContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- STYLED BOTTOM TOOLBAR -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFD700"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. PLAY NOW BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.2"
            android:backgroundTint="#D50000"
            android:fontFamily="@font/pixeboy"
            android:paddingHorizontal="8dp"
            android:text="PLAY NOW"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:strokeColor="#FF5252"
            app:strokeWidth="1dp" />

        <!-- 2. BROWSE ALL CARDS BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/browseCardsButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.8"
            android:backgroundTint="#252A31"
            android:fontFamily="@font/pixeboy"
            android:paddingHorizontal="6dp"
            android:text="BROWSE ALL CARDS"
            android:textColor="#FFD700"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_compass"
            app:iconGravity="textStart"
            app:iconTint="#FFD700"
            app:strokeColor="#737B84"
            app:strokeWidth="1dp" />

        <!-- 3. RULES BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rulesButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="#252A31"
            android:fontFamily="@font/pixeboy"
            android:paddingHorizontal="8dp"
            android:text="RULES"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:strokeColor="#737B84"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

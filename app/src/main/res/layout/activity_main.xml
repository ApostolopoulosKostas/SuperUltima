<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131A"
    tools:context=".MainActivity">

    <!-- TITLE -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/pixeboy"
        android:text="SUPER ULTIMA"
        android:textColor="#FFD700"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- HORIZONTAL SCROLLVIEW FOR ALL DECKS -->
    <HorizontalScrollView
        android:id="@+id/decksHorizontalScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText">

        <!-- DYNAMIC DECKS HOLDER -->
        <LinearLayout
            android:id="@+id/decksContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- AIRPLANES DECK -->
            <LinearLayout
                android:id="@+id/airplanesPackContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/airplanesPack1"
                    android:layout_width="110dp"
                    android:layout_height="140dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#FFD700"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/cardeckbackround"
                            android:scaleType="centerCrop">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="212dp"
                                android:src="@drawable/airplane1frontimage" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/airplanesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/homevideoboldr90dv"
                    android:text="AIRPLANES"
                    android:textColor="#2B65EC"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- STYLED BOTTOM TOOLBAR -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFD700"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. PLAY NOW BUTTON (EXACT) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.2"
            android:backgroundTint="#D50000"
            android:fontFamily="@font/pixeboy"
            android:paddingHorizontal="8dp"
            android:text="PLAY NOW"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:strokeColor="#FF5252"
            app:strokeWidth="1dp" />

        <!-- 2. BROWSE ALL CARDS BUTTON (EXACT) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/browseCardsButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.8"
            android:backgroundTint="#252A31"
            android:fontFamily="@font/pixeboy"
            android:paddingHorizontal="6dp"
            android:text="BROWSE ALL CARDS"
            android:textColor="#FFD700"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_compass"
            app:iconGravity="textStart"
            app:iconTint="#FFD700"
            app:strokeColor="#737B84"
            app:strokeWidth="1dp" />

        <!-- 3. RULES BUTTON (STYLIZED TO MATCH) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/rulesButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="#252A31"
            android:fontFamily="@font/pixeboy"
            android:paddingHorizontal="8dp"
            android:text="RULES"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:strokeColor="#737B84"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
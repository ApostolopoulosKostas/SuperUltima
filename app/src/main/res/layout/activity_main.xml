<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131A"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUPER ULTIMA"
        android:textColor="#FFD700"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/airplanesPack1"
        android:layout_width="110dp"
        android:layout_height="140dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="#FFD700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/cardeckbackround"
                android:scaleType="centerCrop"
                >

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="212dp"
                    android:src="@drawable/airplane1frontimage">


                </ImageView>

            </FrameLayout>

        </LinearLayout>




    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/airplanesText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="AIRPLANES"
        android:textColor="#2B65EC"
        android:textSize="16sp"
        android:fontFamily="@font/homevideoboldr90dv"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/airplanesPack1"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@id/airplanesPack1"
        app:layout_constraintTop_toBottomOf="@id/airplanesPack1" />


    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFD700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/playButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PLAY"
            android:textColor="#F8C11B17"
            android:textStyle="bold"
            android:backgroundTint="#252A31"/>

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="WELCOME"
            android:textColor="@color/black"
            android:fontFamily="@font/homevideoboldr90dv"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/rulesButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RULES"
            android:textColor="#FF000000"
            android:textStyle="bold"
            android:backgroundTint="#252A31"/>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131A">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/airplanesDeck"
        android:layout_width="110dp"
        android:layout_height="140dp"
        android:layout_marginTop="9dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="#FFD700"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cardeckbackround">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="212dp"
                android:src="@drawable/airplane1frontimage" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/selectDeckText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT DECK"
        android:textColor="#FFD700"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/homevideoboldr90dv"
        android:layout_marginBottom="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>